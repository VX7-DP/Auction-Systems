# Production settings for the one-VM deploy (docs/deploy.md). Copy this file to .env in
# the repo root and fill in the blanks:
#   cp deploy/.env.example .env && chmod 600 .env
# Never commit .env (the root .gitignore excludes it).

# Lets plain `docker compose ...` commands use the production override.
COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.prod.yml

# The public host name. Caddy gets its certificate from Let's Encrypt. For a local test of
# this stack, use localhost instead, which gets a certificate from Caddy's internal CA.
SITE_ADDRESS=auction.summittech.in

# Required. Generate each value with: openssl rand -hex 32
# Keep POSTGRES_PASSWORD hex, because it goes into a database URL. Postgres reads it only
# when it first creates its data volume; changing it later needs ALTER USER as well.
POSTGRES_PASSWORD=
SESSION_SECRET=
# Typed into the admin page.
ADMIN_PASSWORD=

# Nightly pg_dump: the host directory, how many days to keep, and the time of day (UTC, HH:MM).
BACKUP_DIR=/var/backups/auction
BACKUP_KEEP_DAYS=14
BACKUP_TIME=03:15
